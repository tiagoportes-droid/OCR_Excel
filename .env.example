# ============================================================
# OpenAI Vision (OPCIONAL - se sem creditos, nao derruba o RPA)
# ============================================================
OPENAI_ENABLED=true
OPENAI_API_KEY=sk-your-key-here

# Modelo multimodal - gpt-4o recomendado por melhor custo-beneficio em visao + texto
OPENAI_MODEL=gpt-4o

# Precos por 1M tokens (configuravel conforme modelo)
OPENAI_INPUT_PRICE_PER_1M=2.50
OPENAI_OUTPUT_PRICE_PER_1M=10.00

# ============================================================
# PaddleOCR (LOCAL - principal fallback, nao depende de API)
# ============================================================
PADDLEOCR_ENABLED=true

# ============================================================
# Google Gemini (multimodal - camada adicional de conferencia)
# ============================================================
GEMINI_ENABLED=true
GEMINI_API_KEY=

# Modelo multimodal Gemini (verificar disponibilidade na sua regiao)
GEMINI_MODEL=gemini-2.0-flash

# ============================================================
# Qwen-VL (multimodal local via Ollama ou Hugging Face)
# ============================================================
QWEN_ENABLED=true

# Para Ollama: use "qwen2.5vl:3b" (leve, ~2GB, roda em 16GB RAM)
# Para Hugging Face: use "Qwen/Qwen2.5-VL-3B-Instruct"
QWEN_MODEL=qwen2.5vl:3b

# URL base do Ollama
QWEN_BASE_URL=http://localhost:11434

# ============================================================
# Comparador OCR
# ============================================================
OCR_REQUIRE_CONSENSUS=true
OCR_MIN_CONFIDENCE=0.80

# ============================================================
# Caminhos do Projeto
# ============================================================
EXCEL_PATH=Controle Financeiro Geral.xlsx

ENTRADA_PATH=arquivos/entrada
PROCESSADOS_PATH=arquivos/processados
FALHAS_PATH=arquivos/falhas

# Caminho do WhatsApp Images (usar %USERPROFILE% ou caminho absoluto)
WHATSAPP_PATH=%USERPROFILE%\Downloads\WhatsApp Images

DATABASE_PATH=banco/processamento.db
LOG_PATH=logs/processamento.log

MAX_WORKERS=4

LOCAL_OCR_FALLBACK=true
DELETE_PROCESSED_FILES=false